; Engine configuration file.
; It is best edited using the Godot editor.
config_version=5

[application]

config/name="Этаж, которого нет"
config/description="Короткий сюжетный пиксельный хоррор. 18+."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0117647, 0.0117647, 0.0156863, 1)
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
UserSettings="*res://scripts/autoload/user_settings.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/size/mode=3

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0117647, 0.0117647, 0.0156863, 1)
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[audio]

buses/default_bus_layout=""